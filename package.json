{
  "name": "grist-widget-pilotage",
  "version": "0.1.0",
  "description": "Widget Grist de pilotage de la stratégie SIGNAL (saisons, chantiers, objectifs, sprints, backlog).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "apercu": "vite preview",
    "types": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:couverture": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verifier:secrets": "node scripts/verifier-secrets.mjs",
    "verifier": "npm run lint && npm run types && npm run test && npm run verifier:secrets && npm run build"
  },
  "dependencies": {
    "@gouvfr/dsfr": "1.15.4",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
